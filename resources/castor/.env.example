# Provider: openrouter | ollama
AI_PROVIDER=ollama

# Model name (provider-specific)
# OpenRouter: openai/gpt-oss-20b:free
# Ollama:     qwen2.5:latest
AI_MODEL=qwen2.5:latest

# OpenRouter only (required when AI_PROVIDER=openrouter)
AI_API_KEY=

# Ollama only (optional, default http://127.0.0.1:11434)
AI_BASE_URL=http://127.0.0.1:11434

# Image generation model (used at import:fixtures:generate ai)
# Ollama:      x/flux2-klein
# OpenRouter:  black-forest-labs/flux.2-klein-4b
AI_IMAGE_MODEL=x/flux2-klein
