{
    "name": "sylius-starter/import",
    "description": "Castor tasks to import an existing shop catalog into Sylius, with optional AI enrichment",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sylius",
        "castor",
        "starter"
    ],
    "homepage": "https://github.com/sylius-starter/sylius-starter",
    "authors": [
        {
            "name": "Loïc Frémont",
            "email": "lfremont@jolicode.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "sylius-starter/core": "self.version",
        "symfony/ai-ollama-platform": "^0.12.0",
        "symfony/ai-open-router-platform": "^0.12.0",
        "symfony/ai-platform": "^0.12.0",
        "symfony/dotenv": "^7.4|^8.0",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "suggest": {
        "jolicode/castor-api": "Expose import tasks over HTTP"
    },
    "autoload": {
        "psr-4": {
            "SyliusStarter\\Import\\": "src/"
        },
        "files": [
            "src/constants.php",
            "src/ImportContext.php",
            "src/ImportBootstrap.php",
            "src/bootstrap.php",
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SyliusStarter\\Import\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
